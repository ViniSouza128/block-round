# Generated high-res texture exports — created by temp/extract_textures.py.
# These are derived from js/textures.js (already base64-embedded) so there's
# no point versioning them. The .py script IS tracked so users can re-run.
temp/textures-hires/

# 1024x1024 nearest-neighbor upscales of textures/*.png, generated by
# tools/upscale_textures.py. Pure derivative — kept local for the
# GPT-variation workflow, not versioned.
textures-1024/

# AI assistant workspace and configuration — private to the author.
.claude/
CLAUDE.md

# LaTeX auxiliary files generated during PDF builds.
docs_math/*.aux
docs_math/*.log
docs_math/*.toc
docs_math/*.out
docs_math/__pycache__/

# Python bytecode anywhere in the repo.
__pycache__/
*.pyc
